# Copy to .env and fill in. Only DEEPINFRA_API_KEY is required.

# --- Required -------------------------------------------------------------
# All models (planner and workers) run on DeepInfra's OpenAI-compatible API.
# Get a key at https://deepinfra.com/dash/api_keys
DEEPINFRA_API_KEY=

# --- Optional: Composio tools ----------------------------------------------
# Without this, agents only have the built-in tools (calc, word_count, add_note),
# so there's no web search. With it, agents get Composio Search by default and you can
# attach other toolkits (Gmail, GitHub, ...) from the Tools drawer in the UI.
# COMPOSIO_API_KEY=
# COMPOSIO_USER_ID=default            # whose connected accounts the tools act as
# COMPOSIO_ALLOW_DESTRUCTIVE=false    # tools tagged destructive stay blocked unless "true"
# COMPOSIO_SESSION_PRESET=            # "direct_tools" exposes toolkit actions directly

# --- Optional: models and limits (defaults shown) ---------------------------
# ORCHESTRATOR_DEFAULT_MODEL=deepseek-ai/DeepSeek-V4-Flash
# ORCHESTRATOR_REASONING_EFFORT=      # override the per-tier effort (low/medium/high)
# ORCHESTRATOR_MODEL_MAX_RETRIES=8    # client retries on 429/overload
# ORCHESTRATOR_MAX_TOOL_CALLS_PER_AGENT=8
# ORCHESTRATOR_MAX_BUILTIN_TOOL_CALLS_PER_AGENT=40
# ORCHESTRATOR_MAX_INPUT_TOKENS_PER_AGENT=300000
# ORCHESTRATOR_MAX_PARALLEL_AGENTS=3
# ORCHESTRATOR_MAX_RUNS_PER_USER=2    # further runs queue

# --- Optional: storage ------------------------------------------------------
# ORCHESTRATOR_DB=runs.db             # SQLite file with run history (prompts and outputs)
# ORCHESTRATOR_FILES_DIR=artifacts    # generated PDFs / slides / PPTX
